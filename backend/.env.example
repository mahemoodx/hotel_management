# =============================================================================
# Royal Pearl Hyderabad – Environment Variables
# Copy this file to .env and fill in your values before running.
# NEVER commit .env to version control.
# =============================================================================

# ---- PostgreSQL -------------------------------------------------------------
DB_NAME=royalpearl
DB_USERNAME=royalpearl
DB_PASSWORD=change_me_strong_password
DB_PORT=5432

# DB_URL is auto-set by docker-compose (uses service name 'postgres').
# Set this manually when running outside Docker:
# DB_URL=jdbc:postgresql://localhost:5432/royalpearl

# ---- Spring Boot ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
API_PORT=8080

# ---- JWT --------------------------------------------------------------------
# Must be at least 32 characters (256-bit key for HS256).
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Token TTLs in seconds (optional – defaults shown)
JWT_ACCESS_TTL=900        # 15 minutes
JWT_REFRESH_TTL=604800    # 7 days

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Admin allowlist --------------------------------------------------------
# Comma-separated emails that may call POST /api/v1/me/claim-admin
ADMIN_ALLOWLIST=bashamahemood579@gmail.com

# ---- Frontend URL (used for OAuth2 redirect) --------------------------------
FRONTEND_URL=http://localhost:5173

# ---- Google OAuth2 (optional – leave as 'disabled' to skip) -----------------
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
